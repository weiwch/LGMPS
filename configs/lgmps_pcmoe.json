{
  "name": "lgmps_pcmoe",
  "model": {
    "attention_pattern": "para_chan_film",
    "query_vocabulary": 151936,
    "semantic_levels": [256, 256, 256],
    "width": 256,
    "layers": 8,
    "head_width": 64,
    "attention_heads": 8,
    "local_heads": 4,
    "history_heads": 4,
    "history_value_expansion": 2.0,
    "feedforward_width": 768,
    "feedforward": "pcmoe",
    "routed_experts": 6,
    "routed_top_k": 1,
    "shared_experts": 0,
    "category_shared_experts": true,
    "expert_width": 384,
    "moe_normalize_topk_probability": true,
    "moe_balance_momentum": 0.9,
    "moe_balance_bias_lr": 0.01,
    "moe_balance_bias_max": 2.0,
    "dropout": 0.0,
    "rope_base": 1000000.0,
    "qk_normalization": true,
    "fusion_bias": false,
    "history_backend": "fla",
    "use_triton_session_attention": true,
    "use_flex_training_attention": true
  },
  "data": {
    "maximum_tokens": 4096,
    "query_term_slots": 10,
    "add_query_markers": true,
    "add_item_marker": true,
    "positive_event_mask": 0,
    "target_policy": "clicked",
    "loader_workers": 4,
    "prefetch_batches": 4,
    "pin_memory": true
  },
  "training": {
    "epochs": 20,
    "batch_size": 20,
    "gradient_accumulation": 1,
    "optimizer": "adam",
    "learning_rate": 0.0001,
    "learning_rate_schedule": "constant",
    "weight_decay": 0.0,
    "gradient_clip": 1600.0,
    "warmup_steps": 0,
    "maximum_steps": 0,
    "maximum_records": 0,
    "log_every": 10,
    "checkpoint_every": 250,
    "validate_every": 0,
    "early_stop_patience": 2,
    "seed": 42,
    "precision": "bfloat16",
    "compile_model": false,
    "resume_mode": "full",
    "gate_capture_every": 0
  },
  "inference": {
    "beam_size": 20,
    "return_sequences": 20,
    "temperature": 1.0,
    "evaluation_limit": 0,
    "batch_size": 4,
    "use_cache": true
  }
}
