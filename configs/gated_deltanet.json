{
  "name": "gated_deltanet",
  "model": {
    "attention_pattern": "gated_deltanet",
    "width": 256,
    "layers": 8,
    "head_width": 64,
    "history_heads": 6,
    "history_value_expansion": 2.0,
    "feedforward_width": 768,
    "history_backend": "fla"
  },
  "training": {
    "epochs": 20,
    "batch_size": 1,
    "learning_rate": 0.0001,
    "early_stop_patience": 2,
    "precision": "bfloat16",
    "gate_capture_every": 100
  },
  "inference": {
    "beam_size": 20,
    "return_sequences": 20
  },
  "data": {}
}
